{
  "name": "jmap-client-ts",
  "version": "2.0.0-alpha.0",
  "description": "Typed JMAP client (RFC 8620, 8621, 8887, 9425, 9007) for browsers and Node",
  "license": "MIT",
  "author": "Linagora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/jmap-client-ts.git"
  },
  "bugs": {
    "url": "https://github.com/linagora/jmap-client-ts/issues"
  },
  "homepage": "https://github.com/linagora/jmap-client-ts#readme",
  "keywords": [
    "jmap",
    "email",
    "rfc8620",
    "rfc8621",
    "rfc8887"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tests/types/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
